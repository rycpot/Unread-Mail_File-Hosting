{
  "manifest_version": 3,
  "name": "Unread Mail",
  "description": "Unread mail from Gmail, Outlook, iCloud, Yahoo, AOL and Proton accounts in one tab.",
  "version": "0.3.0",
  "minimum_chrome_version": "116",
  "key": "",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "identity",
    "storage",
    "alarms",
    "nativeMessaging",
    "cookies",
    "declarativeNetRequestWithHostAccess",
    "scripting"
  ],
  "host_permissions": [
    "https://gmail.googleapis.com/*",
    "https://login.microsoftonline.com/*",
    "https://graph.microsoft.com/*",
    "https://mail.proton.me/*",
    "https://account.proton.me/*"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Unread Mail"
  },
  "content_scripts": [
    {
      "matches": [
        "https://mail.proton.me/*"
      ],
      "js": [
        "src/content/proton-session.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
