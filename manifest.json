{
  "manifest_version": 3,
  "name": "Unread Mail",
  "description": "Unread mail from Gmail, Outlook, iCloud, Yahoo, AOL and Proton accounts in one tab.",
  "version": "0.12.1",
  "minimum_chrome_version": "120",
  "key": "",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "identity",
    "storage",
    "alarms",
    "nativeMessaging",
    "cookies",
    "declarativeNetRequestWithHostAccess",
    "scripting",
    "notifications",
    "offscreen",
    "unlimitedStorage",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://gmail.googleapis.com/*",
    "https://login.microsoftonline.com/*",
    "https://graph.microsoft.com/*",
    "https://mail.proton.me/*",
    "https://account.proton.me/*",
    "https://catbox.moe/*",
    "https://up.x02.me/*",
    "https://files.catbox.moe/*",
    "https://*.x02.me/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Unread Mail",
    "default_icon": {
      "16": "icons/icon-plain-16.png",
      "32": "icons/icon-plain-32.png",
      "48": "icons/icon-plain-48.png",
      "128": "icons/icon-plain-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://mail.proton.me/*"
      ],
      "js": [
        "src/content/proton-session.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ]
}
